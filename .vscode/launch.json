{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Playwright: depurar archivo actual",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "${relativeFile}",
        "--headed",
        "--workers=1",
        "--project=chromium"
      ],
      "cwd": "${workspaceFolder}",
      "env": { "PWDEBUG": "1" },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Playwright: depurar toda la suite",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "--headed",
        "--workers=1",
        "--project=chromium"
      ],
      "cwd": "${workspaceFolder}",
      "env": { "PWDEBUG": "1" },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
